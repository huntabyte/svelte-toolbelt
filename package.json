{
	"name": "svelte-toolbelt",
	"version": "0.11.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/huntabyte/svelte-toolbelt.git"
	},
	"scripts": {
		"dev": "pnpm --reporter append-only --color \"/dev:/\"",
		"dev:svelte": "vite dev",
		"dev:pkg": "svelte-package --watch",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"ci:publish": "pnpm package && changeset publish"
	},
	"funding": [
		"https://github.com/sponsors/huntabyte"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.30.2"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@svitejs/changesets-changelog-github-compact": "^1.1.0",
		"@types/node": "^24.19.2",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/scope-manager": "^8.72.1",
		"@typescript-eslint/utils": "^8.72.1",
		"csstype": "^3.2.3",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^17.14.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^0.43.0",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"runed": "^0.35.1",
		"style-to-object": "^1.0.8"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"engines": {
		"pnpm": ">=8.7.0",
		"node": ">=18"
	},
	"packageManager": "pnpm@8.15.8",
	"sideEffects": false
}
